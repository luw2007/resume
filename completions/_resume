#compdef resume

autoload -U is-at-least

_resume() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'(-D --down)-U+[Include ancestor directories up to N edges, or all]:N|all:_default' \
'(-D --down)--up=[Include ancestor directories up to N edges, or all]:N|all:_default' \
'(-U --up)-D+[Include descendant directories down to N edges, or all]:N|all:_default' \
'(-U --up)--down=[Include descendant directories down to N edges, or all]:N|all:_default' \
'*-a+[Only this agent; repeatable; replaces configured agents]:AGENT:_default' \
'*--agent=[Only this agent; repeatable; replaces configured agents]:AGENT:_default' \
'--since=[Only Sessions active at or after this cutoff]:duration|date|all:_default' \
'--config=[Read this config file instead of the discovered one]:CONFIG:_files' \
'--list[Print the plain table instead of opening the picker]' \
'--json[Print JSON v1 to stdout; implies --list]' \
'--verbose[Include redacted paths and error chains in diagnostics]' \
'(--no-confirm)--confirm-always[Ask for confirmation before every Resume]' \
'(--confirm-always)--no-confirm[Skip ordinary confirmation; risk prompts still apply]' \
'--man[Print the full manual page and exit]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'::directory -- Directory whose Sessions to search (default\: current dir):_files' \
":: :_resume_commands" \
"*::: :->resume" \
&& ret=0
    case $state in
    (resume)
        words=($line[2] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:resume-command-$line[2]:"
        case $line[2] in
            (config)
_arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
":: :_resume__subcmd__config_commands" \
"*::: :->config" \
&& ret=0

    case $state in
    (config)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:resume-config-command-$line[1]:"
        case $line[1] in
            (example)
_arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_resume__subcmd__config__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:resume-config-help-command-$line[1]:"
        case $line[1] in
            (example)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell:((bash\:"Bash completion script for bash-completion"
zsh\:"Zsh completion script for the zsh compsys autoloader"
fish\:"Fish completion script for fish shell"))' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_resume__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:resume-help-command-$line[1]:"
        case $line[1] in
            (config)
_arguments "${_arguments_options[@]}" : \
":: :_resume__subcmd__help__subcmd__config_commands" \
"*::: :->config" \
&& ret=0

    case $state in
    (config)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:resume-help-config-command-$line[1]:"
        case $line[1] in
            (example)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_resume_commands] )) ||
_resume_commands() {
    local commands; commands=(
'config:Inspect resume configuration' \
'completions:Print a shell completion script to stdout' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'resume commands' commands "$@"
}
(( $+functions[_resume__subcmd__completions_commands] )) ||
_resume__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'resume completions commands' commands "$@"
}
(( $+functions[_resume__subcmd__config_commands] )) ||
_resume__subcmd__config_commands() {
    local commands; commands=(
'example:Print a commented example configuration file' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'resume config commands' commands "$@"
}
(( $+functions[_resume__subcmd__config__subcmd__example_commands] )) ||
_resume__subcmd__config__subcmd__example_commands() {
    local commands; commands=()
    _describe -t commands 'resume config example commands' commands "$@"
}
(( $+functions[_resume__subcmd__config__subcmd__help_commands] )) ||
_resume__subcmd__config__subcmd__help_commands() {
    local commands; commands=(
'example:Print a commented example configuration file' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'resume config help commands' commands "$@"
}
(( $+functions[_resume__subcmd__config__subcmd__help__subcmd__example_commands] )) ||
_resume__subcmd__config__subcmd__help__subcmd__example_commands() {
    local commands; commands=()
    _describe -t commands 'resume config help example commands' commands "$@"
}
(( $+functions[_resume__subcmd__config__subcmd__help__subcmd__help_commands] )) ||
_resume__subcmd__config__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'resume config help help commands' commands "$@"
}
(( $+functions[_resume__subcmd__help_commands] )) ||
_resume__subcmd__help_commands() {
    local commands; commands=(
'config:Inspect resume configuration' \
'completions:Print a shell completion script to stdout' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'resume help commands' commands "$@"
}
(( $+functions[_resume__subcmd__help__subcmd__completions_commands] )) ||
_resume__subcmd__help__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'resume help completions commands' commands "$@"
}
(( $+functions[_resume__subcmd__help__subcmd__config_commands] )) ||
_resume__subcmd__help__subcmd__config_commands() {
    local commands; commands=(
'example:Print a commented example configuration file' \
    )
    _describe -t commands 'resume help config commands' commands "$@"
}
(( $+functions[_resume__subcmd__help__subcmd__config__subcmd__example_commands] )) ||
_resume__subcmd__help__subcmd__config__subcmd__example_commands() {
    local commands; commands=()
    _describe -t commands 'resume help config example commands' commands "$@"
}
(( $+functions[_resume__subcmd__help__subcmd__help_commands] )) ||
_resume__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'resume help help commands' commands "$@"
}

if [ "$funcstack[1]" = "_resume" ]; then
    _resume "$@"
else
    compdef _resume resume
fi
